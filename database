-- ===== BẢNG CHI PHÍ NGUYÊN LIỆU =====
-- Thêm cột chi phí nguyên liệu vào bảng products
ALTER TABLE products 
ADD COLUMN material_cost DECIMAL(10,2) DEFAULT 0 COMMENT 'Chi phí nguyên liệu cho 1 sản phẩm';

-- Cập nhật chi phí mẫu (có thể bỏ qua nếu muốn nhập thủ công)
-- Giả định chi phí nguyên liệu = 40% giá bán
UPDATE products 
SET material_cost = price * 0.4 
WHERE material_cost = 0;

-- ===== VIEW TÍNH LỢI NHUẬN =====
-- View để tính lợi nhuận cho từng đơn hàng
CREATE OR REPLACE VIEW order_profit_view AS
SELECT 
    o.order_id,
    o.user_id,
    o.order_date,
    o.total_amount as revenue,
    SUM(oi.quantity * p.material_cost) as total_material_cost,
    o.total_amount - SUM(oi.quantity * p.material_cost) as profit,
    ((o.total_amount - SUM(oi.quantity * p.material_cost)) / o.total_amount * 100) as profit_margin
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
JOIN products p ON oi.product_id = p.product_id
WHERE o.status = 'completed'
GROUP BY o.order_id;

-- ===== VIEW BÁO CÁO TỔNG HỢP =====
-- View báo cáo tổng hợp theo ngày
CREATE OR REPLACE VIEW daily_profit_report AS
SELECT 
    DATE(o.order_date) as report_date,
    COUNT(DISTINCT o.order_id) as total_orders,
    SUM(o.total_amount) as total_revenue,
    SUM(oi.quantity * p.material_cost) as total_material_cost,
    SUM(o.total_amount) - SUM(oi.quantity * p.material_cost) as total_profit,
    ((SUM(o.total_amount) - SUM(oi.quantity * p.material_cost)) / SUM(o.total_amount) * 100) as profit_margin
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
JOIN products p ON oi.product_id = p.product_id
WHERE o.status = 'completed'
GROUP BY DATE(o.order_date)
ORDER BY report_date DESC;

